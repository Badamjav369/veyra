{
  "name": "shivnee-e2ee-chat",
  "private": true,
  "version": "0.1.0",
  "description": "SHIVNEE \u2014 quiet, end-to-end encrypted chat (React client + Node relay)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p server --noEmit && tsc -p cloudflare --noEmit && vite build",
    "start": "vite build && tsx server/index.ts",
    "test": "tsx tests/e2ee.test.ts",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit && tsc -p cloudflare --noEmit",
    "cf:dev": "vite build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
